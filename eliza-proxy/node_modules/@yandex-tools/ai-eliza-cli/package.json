{
    "name": "@yandex-tools/ai-eliza-cli",
    "type": "module",
    "engines": {
        "node": ">=22",
        "npm": ">=10"
    },
    "bin": {
        "eliza-cli": "build/cli.js"
    },
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js"
        }
    },
    "dependencies": {
        "@yandex-int/yandex-logger": "9.6.2",
        "commander": "13.1.0"
    },
    "devDependencies": {
        "@types/jest": "29.4.0",
        "jest": "29.4.3",
        "prettier": "2.8.4",
        "rimraf": "4.1.2",
        "ts-jest": "29.0.5",
        "typescript": "5.4.5"
    },
    "scripts": {
        "clean": "rimraf build/",
        "build": "npm run clean && npm run compile",
        "compile": "tsc && chmod +x build/cli.js",
        "cli": "npm run build && node build/cli.js",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.json",
        "lint": "prettier --ignore-path ../.prettierignore --check .",
        "fix-style": "prettier --ignore-path ../.prettierignore --write ."
    },
    "version": "0.1.4",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "https://a.yandex-team.ru/arcadia/taxi/mobile/ai/productivity/ai-infra-clients",
        "directory": "eliza-client"
    },
    "publishConfig": {
        "registry": "https://npm.yandex-team.ru/"
    },
    "files": [
        "build"
    ]
}
